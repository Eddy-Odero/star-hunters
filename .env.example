# Backend runtime configuration (FastAPI / Uvicorn)
PORT=8000
SQLITE_DB_PATH=/data/spherex_cache.db
ADMIN_TOKEN=star-hunters-dev-token

# Enable live archival image retrieval (SPHEREx IRSA -> WISE/NEOWISE -> NASA SkyView -> Horizons).
# Keep false (default) during offline unit tests for deterministic simulated frames.
ENABLE_ARCHIVAL_DATA=true

# Backend startup logging configuration
# Valid levels: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Valid formats: text | json
LOG_FORMAT=text

# Optional IRSA / archival timeout and circuit-breaker budgets (seconds)
IRSA_CONNECT_TIMEOUT_S=3.5
IRSA_DISCOVERY_TIMEOUT_S=10.0
IRSA_CUTOUT_TIMEOUT_S=8.0
SPHEREX_INGEST_BUDGET_S=16.0
ARCHIVAL_RESOLVE_BUDGET_S=18.0
IRSA_CIRCUIT_COOLDOWN_S=45.0

# Frontend build/runtime discrete event logger configuration
# Valid levels: debug | info | warn | error | silent
VITE_LOG_LEVEL=info
VITE_LOG_BUFFER_SIZE=200
